const IMAGE_URL = "https://j.top4top.io/p_3894432qz0.jpg";

const context = (jid) => ({
    mentionedJid: [jid],
    isForwarded: true,
    forwardingScore: 1,
    forwardedNewsletterMessageInfo: {
        newsletterJid: '1556853817@newsletter',
        newsletterName: '𓆩 𝑨𝑳𝑯𝑾𝑨𝑹𝒀 𓆪',
        serverMessageId: 0
    },
    externalAdReply: {
        title: "𓆩⚡ 𝑨𝑳𝑯𝑾𝑨𝑹𝒀 𝑪𝑶𝑹𝑬 ⚡𓆪",
        body: "°⃟⚡ SYSTEM: ONLINE",
        thumbnailUrl: IMAGE_URL,
        sourceUrl: '',
        mediaType: 1,
        renderLargerThumbnail: true
    }
});

async function handler(m, { conn, args, command }) {
    const query = args.join(' ').trim();

    if (!query) {
        await conn.sendMessage(m.chat, {
            text: `╭─❖ تنبيه ❖─╮\n📍 الرجاء إدخال اسم المدينة.\n\nمثال:\n.${command} القاهرة\n╰────────────╯`,
            contextInfo: context(m.sender)
        }, { quoted: m });
        return;
    }

    await m.react('⏳');

    let data;
    try {
        const res = await fetch(`https://wttr.in/${encodeURIComponent(query)}?format=j1`, {
            signal: AbortSignal.timeout(15000)
        });
        if (!res.ok) throw new Error(`فشل جلب بيانات الطقس (HTTP ${res.status})`);
        data = await res.json();
    } catch (e) {
        console.error('[WEATHER]', e?.message || e);
        await m.react('❌');
        await conn.sendMessage(m.chat, {
            text: `╭─❖ خطأ ❖─╮\n⚠️ حصل خطأ أثناء جلب بيانات الطقس، تأكد من اسم المدينة وحاول تاني.\n╰────────────╯`,
            contextInfo: context(m.sender)
        }, { quoted: m });
        return;
    }

    try {
        const current = data.current_condition[0];
        const location = data.nearest_area[0];

        const cityName = location.areaName[0].value;
        const country = location.country[0].value;
        const tempC = current.temp_C;
        const feelsLike = current.FeelsLikeC;
        const desc = current.weatherDesc[0].value;
        const humidity = current.humidity;
        const windKmph = current.windspeedKmph;
        const uvIndex = current.uvIndex;

        const replyText = `
*╭━━━ 🌤️ حالة الطقس ━━━°⃟⚡*
┃ *المدينة:* ${cityName} (${country})
┃
┃ 🌡️ *درجة الحرارة:* ${tempC}°C
┃ 🤔 *الإحساس الفعلي:* ${feelsLike}°C
┃ ☁️ *الحالة:* ${desc}
┃ 💧 *الرطوبة:* ${humidity}%
┃ 🌬️ *سرعة الرياح:* ${windKmph} كم/س
┃ ☀️ *مؤشر الأشعة UV:* ${uvIndex}
*╰━━━━━━━━━━━━━━━━━━━°⃟⚡*
        `.trim();

        await conn.sendMessage(m.chat, {
            text: replyText,
            contextInfo: context(m.sender)
        }, { quoted: m });

        await m.react('✅');
    } catch (e) {
        console.error('[WEATHER PARSE]', e?.message || e);
        await m.react('❌');
        await conn.sendMessage(m.chat, {
            text: `╭─❖ خطأ ❖─╮\n⚠️ مقدرتش أفهم بيانات الطقس المرجعة، جرب اسم مدينة تاني.\n╰────────────╯`,
            contextInfo: context(m.sender)
        }, { quoted: m });
    }
}

handler.help = ['طقس <اسم المدينة>'];
handler.category = 'tools';
handler.command = ['طقس', 'weather', 'الطقس'];

export default handler;